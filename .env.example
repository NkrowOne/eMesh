# ================== eMesh ==================
# Copia este archivo a .env y rellena los valores.
# Las variables que no pongas (o dejes vacías) usan su valor por defecto.

# --- Telegram (obligatorio) ---
# Token del bot principal (de @BotFather)
BOT_TOKEN=123456789:AAAA-tu-token
# Tu ID de Telegram (súper administrador). Varios: separados por comas.
# Para saber tu ID: arranca el bot y escribe /id
SUPER_ADMIN_IDS=8191150217

# --- Base de datos (obligatorio en producción) ---
# Railway: añade la variable DATABASE_URL=${{Postgres.DATABASE_URL}} (no se añade sola).
# Local: postgresql+asyncpg://user:pass@localhost:5432/emesh
DATABASE_URL=postgresql+asyncpg://emesh:emesh@localhost:5432/emesh

# --- Seguridad (obligatorio si usas clones) ---
# Cifra los tokens de los bots clonados. Genera uno con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡No lo cambies después o los clones dejarán de funcionar!
ENCRYPTION_KEY=

# --- eButtons (opcional) ---
# Quien ya eligió su zona horaria en eButtons (o en eMesh) no tiene que elegirla otra vez.
# Si eButtons usa la misma base de datos que eMesh, déjalo vacío. Si usa otra, pon aquí su DATABASE_URL.
EBUTTONS_DATABASE_URL=

# --- Bot principal ---
# full: el bot principal distribuye mensajes como cualquier clon (y además crea clones y tiene el 👑 Panel)
# hub: el bot principal solo explica el servicio, crea clones y tiene el 👑 Panel
MAIN_BOT_MODE=full
# Copias del bot principal con otros nombres: sus tokens, separados por comas.
EXTRA_MAIN_TOKENS=

# --- Clones (valores iniciales; se cambian en 👑 Panel › ⚙️ Plataforma) ---
# open: cualquiera crea su bot · approval: la administración lo aprueba · closed: nadie
CLONE_POLICY=open
MAX_CLONES_PER_USER=3
# Límites por clon (0 = sin límite)
DEFAULT_LIMIT_CHATS=0
DEFAULT_LIMIT_POSTS=0

# --- Modo de funcionamiento ---
# polling (por defecto, no necesita dominio) o webhook (necesita URL pública HTTPS)
MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
PORT=8080

# --- Valores por defecto ---
DEFAULT_LANG=es
DEFAULT_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO

# --- Motor ---
# Un turno o un envío programado que llega más tarde de esto (el bot estaba parado) se salta.
LATE_SKIP_MINUTES=30
# Chats a los que un envío manda a la vez (los límites de Telegram se respetan igualmente).
SEND_CONCURRENCY=8
# Cada cuántas horas se revisan miembros, nombre y permisos de cada chat.
MAINTENANCE_INTERVAL_HOURS=6
# Hora del resumen diario a los admins (zona horaria del bot).
SUMMARY_HOUR=9
# Días que se guardan los envíos y la actividad.
RETENTION_DAYS=30

# --- Límites de Telegram (no los subas si no sabes lo que haces) ---
RL_GLOBAL_PER_SEC=27
RL_BULK_PER_SEC=20
RL_PRIVATE_PER_SEC=1
RL_PRIVATE_BURST=3
RL_GROUP_PER_MIN=19
